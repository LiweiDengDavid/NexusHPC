# Per-project source of truth: reuse this binding; never write values back to the skill template.
# Trusted shell configuration: inspect before sourcing; never store secrets here.
# init saves a valid slug from the initial folder name; fill it if generation failed.
# Keep this stable when moving/renaming the folder; give genuinely new project copies a new slug.
# Verify REMOTE_HOST:REMOTE_BASE_DIR/PROJECT_SLUG is not accidentally shared by another project.
PROJECT_SLUG=""

# Required: use existing project settings or values supplied by the user.
# Missing required values mean awaiting binding; initialization does not sync or submit.
REMOTE_HOST=""
REMOTE_BASE_DIR=""
LOCAL_CONDA_ENV=""
REMOTE_CONDA_ENV=""
PBS_QUEUE=""
# Required only for submission; use a project wrapper for smoke -> validation -> full.
# Example: TRAIN_COMMAND="bash scripts/run/smoke_then_full.sh" (create it for your project).
# Stop on smoke failure, then exec resumable full training; keep smoke state separate.
# Do not put "smoke && full" directly here: the job runner prefixes this value with exec.
# Also inspect checkpoints/DONE_FILE when copying a project.
TRAIN_COMMAND=""

# Leave empty to resolve PBS commands from the remote PATH.
QSUB_BIN=""
QSTAT_BIN=""
QDEL_BIN=""
# Optional trusted remote conda initialization script for non-interactive shells.
CONDA_SH=""

# Example resources, not cluster limits: confirm the selected queue's policy.
PBS_WALLTIME="01:00:00"
PBS_NGPUS="1"
PBS_NCPUS="4"
PBS_MEM="64gb"
# One allocation by default; explicitly enable a finite chain when work needs more slices.
MAX_CONTINUATIONS="0"
# Slice + termination grace must be strictly shorter than PBS_WALLTIME.
SLICE_SECONDS="3000"
TERM_GRACE_SECONDS="300"

# Training must resume automatically and write DONE_FILE only after validation.
CHECKPOINT_FILE="outputs/checkpoints/resume_state.pt"
DONE_FILE="outputs/status/TRAINING_COMPLETE"
SYNC_DELETE="1"
