#!/usr/bin/env bash
set -euo pipefail
project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
source "${project_dir}/.workflow/config.env"
: "${REMOTE_HOST:?Set REMOTE_HOST in .workflow/config.env}"
: "${REMOTE_BASE_DIR:?Set REMOTE_BASE_DIR in .workflow/config.env}"
: "${PROJECT_SLUG:?Set PROJECT_SLUG in .workflow/config.env}"
remote_project="${REMOTE_BASE_DIR%/}/${PROJECT_SLUG}"
if [[ -t 1 && -z "${NO_COLOR:-}" && "${TERM:-}" != dumb ]]; then
    set -- --color "$@"
fi
printf -v remote_command '%q ' "${HPC_STATUS_REMOTE_PYTHON:-/usr/bin/python3}" -B "${remote_project}/.workflow/remote/task_status.py" --json
# Remote collection remains read-only. Only the Mac presentation layer records
# first-view timestamps, as explicitly requested for 24-hour dismissal.
ssh "${REMOTE_HOST}" "${remote_command}" |
    conda run --no-capture-output -n "${LOCAL_CONDA_ENV:-python312}" python -B \
        "${project_dir}/scripts/render_hpc_status.py" "$@"
